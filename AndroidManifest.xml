<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tv98.glow">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Granted once over adb (pm grant): lets Glow's settings switch developer access (ADB) off and on. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Glow Settings ▸ Screensaver sets the idle time before the screensaver starts. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Glow Settings ▸ Update installs a newer Glow from GitHub Releases (Android asks the viewer to confirm). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Banners over other apps (notifications, score alerts): only once the viewer allows "display over other apps". -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".GlowApp"
        android:label="Glow"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Glow"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <activity
            android:name=".HomeActivity"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".ChannelsActivity" />
        <activity android:name=".PlayerActivity" android:theme="@style/Glow.Player" />
        <activity android:name=".SearchActivity" android:windowSoftInputMode="stateVisible|adjustNothing" />
        <activity android:name=".WorldActivity" />
        <activity android:name=".RemoteActivity" />
        <activity android:name=".SettingsActivity" />
        <activity android:name=".ClassicGuideActivity" />
        <activity android:name=".AppsActivity" />
        <activity android:name=".IntelActivity" />
        <activity android:name=".ExtraAppsActivity" />
        <activity android:name=".ButtonsActivity" />
        <activity android:name=".NotificationsActivity" />
        <!-- Other apps' notifications as banners and a list in Glow; only with notification access, granted by the viewer. -->
        <service android:name=".GlowNotifications" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity android:name=".QuickSettingsActivity" android:theme="@style/Glow.Panel" android:excludeFromRecents="true" />
        <activity android:name=".F1Activity" />
        <activity android:name=".PinActivity" android:theme="@style/Glow.Panel" android:excludeFromRecents="true" />
        <!-- "Glow remote buttons": the viewer's button jobs in every app. Switched on by the viewer in Android's
             Accessibility settings; it only acts on buttons they set in Glow and never reads the screen. -->
        <service android:name=".GlowButtons" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/glow_buttons" />
        </service>

        <!-- Hears back from Android's installer when Glow installs an update from GitHub Releases. -->
        <receiver android:name=".Updates$Result" android:exported="false" />

        <!-- Ambient screensaver (clock, weather, headlines with pictures, what's on now). -->
        <service android:name=".GlowDream" android:exported="true" android:label="Glow ambient"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
